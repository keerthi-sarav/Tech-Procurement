# =============================================================
#  SOGFusion Procurement — .gitignore
# =============================================================

# -------------------------------------------------------------
# 🔐 ENVIRONMENT & SECRETS (NEVER push these to GitHub)
# -------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.*.local
*.env
config.secret.*
secrets.json

# -------------------------------------------------------------
# 🐍 PYTHON / FASTAPI BACKEND
# -------------------------------------------------------------
# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual environments (local Python installs)
venv/
.venv/
env/
ENV/
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Unit test & coverage reports
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# mypy type checker
.mypy_cache/
.dmypy.json

# PyInstaller
*.spec

# -------------------------------------------------------------
# ⚛️  NODE.JS / REACT FRONTEND
# -------------------------------------------------------------
# Dependencies (reinstall with: npm install)
node_modules/

# Build output (regenerated with: npm run build)
dist/
build/

# Vite cache
.vite/
*.local

# npm / yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# -------------------------------------------------------------
# 🗄️  DATABASE DUMPS & BACKUPS
# -------------------------------------------------------------
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
db_backup/
database_backup/

# -------------------------------------------------------------
# 🖥️  OPERATING SYSTEM FILES
# -------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# -------------------------------------------------------------
# 🛠️  IDE & EDITOR FILES
# -------------------------------------------------------------
# VS Code (keep .vscode/extensions.json if you want, but not settings)
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.log

# JetBrains (PyCharm, WebStorm)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs swap files
*.swp
*.swo
*~

# -------------------------------------------------------------
# 📋 LOGS & TEMPORARY FILES
# -------------------------------------------------------------
logs/
*.log
log/
temp/
tmp/
*.tmp
*.temp
*.bak
*.backup
*.orig

# -------------------------------------------------------------
# 📦 MISC
# -------------------------------------------------------------
# Compressed archives
*.zip
*.tar.gz
*.rar
*.7z

# Test output
test-results/
coverage/
